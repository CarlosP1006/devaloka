{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES6", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "paths": {
      "@assets/*": ["./assets/*"],
      "@maps/*": ["./maps/*"],
      "@scenes/*": ["./src/scenes/*"],
      "@objects/*": ["./src/objects/*"],
      "@utils/*": ["./src/utils/*"],
      "@services/*": ["./src/services/*"],
      "@containers/*": ["./src/containers/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
